# Caddy gives you automatic HTTPS (Let's Encrypt). Replace the domain, point its DNS A/AAAA record at the VPS, then:  sudo caddy reload
piyu.example.com {
	encode zstd gzip

	# Piyu streams answers (voice, AI, web); do not buffer them.
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
	}

	request_body {
		max_size 200MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# microphone (Hey Piyu / voice input) and camera (photo -> OCR) only for Piyu itself
		Permissions-Policy "microphone=(self), camera=(self), geolocation=()"
		-Server
	}
}
