# copy to /etc/piyu.env  (chmod 600) and edit
# Caddy listens on 443 and forwards here; the app is never exposed directly
PIYU_HOST=127.0.0.1
PIYU_PORT=8080
# SQLite database lives here: piyu.sqlite3  (back this up)
PIYU_DATA=/var/lib/piyu
# e.g.  openssl rand -base64 24   (required: the server refuses to start public without it)
PIYU_TOKEN=CHANGE-ME-long-random-string
# trust X-Forwarded-For from Caddy (rate limits use the real client IP) — only when behind Caddy
PIYU_BEHIND_PROXY=1
# voices kept in RAM (each ~150-300 MB). 2 GB VPS: keep 2
PIYU_MAX_VOICES=2
# free web fallback sources; "off" disables it
PIYU_WEB=wikipedia,ddg
# your own SearXNG (optional, free meta-search)
#PIYU_SEARXNG=http://127.0.0.1:8888
# local LLM (optional; needs a bigger VPS)
#PIYU_OLLAMA=http://127.0.0.1:11434
