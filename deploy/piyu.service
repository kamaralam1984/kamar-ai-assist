# /etc/systemd/system/piyu.service
[Unit]
Description=Piyu personal assistant (Python backend + SQLite + Piper voices)
After=network-online.target
Wants=network-online.target

[Service]
User=piyu
Group=piyu
WorkingDirectory=/opt/piyu
EnvironmentFile=/etc/piyu.env
ExecStart=/opt/piyu/.venv/bin/python /opt/piyu/server.py
Restart=always
RestartSec=3

# hardening: the service can only write to its data directory
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/piyu
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryMax=1800M

[Install]
WantedBy=multi-user.target
